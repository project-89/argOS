{
  "name": "argos-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Entry-point commands for the active Argos simulation engine in v2",
  "scripts": {
    "setup": "npm --prefix v2 ci",
    "start": "npm --prefix v2 run demo:spatial -- --town",
    "demo:spatial": "npm --prefix v2 run demo:spatial --",
    "dev": "npm --prefix v2 run dev",
    "build": "npm --prefix v2 run build",
    "typecheck": "npm --prefix v2 run typecheck",
    "test": "npm --prefix v2 test --",
    "test:viewer": "cd v2 && node --test src/demo/spatial-client/*.test.mjs"
  }
}
