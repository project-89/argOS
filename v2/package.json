{
  "name": "argos-v2",
  "version": "0.1.0",
  "description": "Self-evolving cognitive architecture for LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -n server,ui -c cyan,magenta \"tsx watch src/run-dev-server.ts\" \"npm run dev --prefix ui\"",
    "dev:server": "tsx watch src/run-dev-server.ts",
    "dev:ui": "npm run dev --prefix ui",
    "start": "tsx src/index.ts",
    "simulate": "tsx src/run-simulation.ts",
    "live:npc": "tsx src/run-live-npc.ts",
    "live:director": "tsx src/run-director.ts",
    "demo:oil": "tsx src/run-oil-demo.ts",
    "demo:phone": "tsx src/run-phone-demo.ts",
    "demo:agents": "tsx src/run-generative-agents.ts",
    "demo:spatial": "tsx src/run-spatial-demo.ts",
    "eval:agents:live": "tsx src/run-generative-agents.ts --live",
    "demo:escape": "tsx src/run-escape-room.ts",
    "eval:escape:live": "tsx src/run-escape-room.ts --live",
    "demo:sitcom": "tsx src/run-sitcom.ts",
    "demo:sitcom:ui": "tsx src/run-sitcom-demo.ts",
    "demo:focused:ui": "tsx src/run-sitcom-demo.ts --focused",
    "eval:focused": "tsx src/demo/focused-phone-check.ts",
    "eval:focused:live": "tsx src/demo/focused-phone-check.ts --live",
    "eval:sitcom:live": "tsx src/run-sitcom.ts --live",
    "eval:sitcom:breakup:live": "tsx src/demo/sitcom-breakup-check.ts --live",
    "test:phone:live": "tsx src/demo/phone-live-check.ts",
    "test:engineering:live": "tsx src/engineering/live-check.ts",
    "eval:pressure": "tsx src/evals/run-pressure.ts",
    "eval:pressure:live": "tsx src/evals/run-live-pressure.ts",
    "eval:cognition": "tsx src/evals/cognition-run.ts",
    "eval:cognition:live": "tsx src/evals/cognition-run.ts --live",
    "eval:cognition:sustained:live": "tsx src/evals/sustained-cognition-run.ts --live",
    "eval:world:live": "tsx src/evals/living-world-soak.ts --live",
    "eval:liveliness": "tsx src/evals/liveliness-score.ts",
    "sandbox": "tsx src/run-sandbox.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=__tests__",
    "test:llm": "ARGOS_RUN_LLM_TESTS=1 node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern='(planning|schedule|reflection)-system.test.ts'",
    "test:behavioral": "tsx src/behavioral-tests/09-cognitive-enhancements.ts",
    "stress-test": "tsx src/behavioral-tests/10-full-simulation-stress-test.ts",
    "stress-test:short": "tsx src/behavioral-tests/10-full-simulation-stress-test.ts --duration=2",
    "stress-test:long": "tsx src/behavioral-tests/10-full-simulation-stress-test.ts --duration=30",
    "stress-test:unified": "tsx src/behavioral-tests/19-unified-api-full-stress-test.ts",
    "demo:godai": "tsx src/behavioral-tests/33-orchestration-eval-repair-harness.ts --durationSec=24 --seed=123 --evalMs=6000 --spiritMs=6000 --daemonPovMs=5000 --autopilotMs=7000",
    "demo:godai:hard": "tsx src/behavioral-tests/19-unified-api-full-stress-test.ts --duration=0.25 --hardTask=full --hardTaskTimeoutMs=30000",
    "typecheck": "tsc --noEmit",
    "extract-sprites": "tsx src/scripts/extract-sprites.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.5",
    "@fal-ai/client": "1.11.0-alpha.2",
    "@slack/bolt": "^4.6.0",
    "ai": "^6.0.14",
    "bitecs": "^0.4.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "nanoid": "^5.0.4",
    "pixi.js": "^8.15.0",
    "three": "0.186.1",
    "undici": "8.10.0",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/sharp": "^0.31.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "gif-frames": "^1.0.1",
    "jest": "^29.7.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
