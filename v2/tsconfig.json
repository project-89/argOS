{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/systems/generated",
    "src/behavioral-tests",
    "src/tests",
    "src/__tests__",
    "src/ecs/__tests__",
    "src/cognition/__tests__",
    "src/world/__tests__",
    "src/spirits/__tests__",
    "src/god/__tests__",
    "src/systems/__tests__"
  ]
}
